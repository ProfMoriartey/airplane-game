[node name="Mission" type="Node" parent="."]
script = ExtResource("3_mission")
title = "Eyes of the Enemy"
briefing = "Enemy observation balloons along the front are directing their artillery onto our trenches. Fly to the front and bring them down - expect anti-aircraft fire around them.

Their fighters will come looking for you once the balloons burn. After that, bomb the supply depot behind their lines, then come home."
intro_radio = PackedStringArray("Command: Morning, pilot. Head north to the front line - follow the yellow marker.", "Command: Bombs are loaded. Press B to drop one, and watch the orange bomb sight for where it will land.")

[node name="ReachFront" type="Node" parent="Mission" node_paths=PackedStringArray("area")]
script = ExtResource("4_reach")
area = NodePath("../../Waypoints/FrontLine")
radius = 350.0
description = "Fly to the front line"
score_bonus = 0

[node name="SilenceGuns" type="Node" parent="Mission" node_paths=PackedStringArray("targets")]
script = ExtResource("5_destroy")
targets = NodePath("../../AAGuns")
description = "Silence the anti-aircraft guns"
optional = true
score_bonus = 150
radio_on_complete = PackedStringArray("Command: Their guns have gone quiet. Nicely done.")

[node name="DestroyBalloons" type="Node" parent="Mission" node_paths=PackedStringArray("targets")]
script = ExtResource("5_destroy")
targets = NodePath("../../Balloons")
description = "Shoot down the observation balloons"
radio_on_start = PackedStringArray("Command: There they are - three balloons. Watch out for the flak!")
radio_on_complete = PackedStringArray("Command: All balloons down! Enemy fighters are scrambling - watch your tail!")

[node name="DestroyFighters" type="Node" parent="Mission" node_paths=PackedStringArray("targets")]
script = ExtResource("5_destroy")
targets = NodePath("../../Interceptors")
description = "Shoot down the enemy fighters"
radio_on_complete = PackedStringArray("Command: Sky's clear. Now hit their supply depot to the north-west.")

[node name="HitConvoy" type="Node" parent="Mission" node_paths=PackedStringArray("targets")]
script = ExtResource("5_destroy")
targets = NodePath("../../Convoy")
description = "Destroy the supply convoy"
optional = true
score_bonus = 200
radio_on_start = PackedStringArray("Scout: There's a convoy on the road heading for the front. Hit it if you can - the trucks burn easily, the tank will need bombs.")
radio_on_complete = PackedStringArray("Scout: Convoy destroyed. That'll hurt them.")

[node name="BombDepot" type="Node" parent="Mission" node_paths=PackedStringArray("targets")]
script = ExtResource("5_destroy")
targets = NodePath("../../Depot")
description = "Bomb the supply depot"
radio_on_start = PackedStringArray("Command: Line up on the depot and drop your bombs. Guns won't do much against buildings.")
radio_on_complete = PackedStringArray("Command: Depot destroyed! Outstanding work. Return to base.")

