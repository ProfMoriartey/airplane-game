[node name="Mission" type="Node" parent="."]
script = ExtResource("mission")
mission_id = "m03"
title = "Convoy Hunt"
briefing = "An enemy supply convoy is moving up to the front along the valley road. Destroy every vehicle before it arrives. Guns will handle the trucks; save your bombs for the tanks. Expect anti-aircraft guns along the road and fighters once they realise what's happening."
intro_radio = PackedStringArray("Command: The convoy is on the road north of the front. Find it and stop it.", "Command: Remember - tanks need bombs.")

[node name="SilenceGuns" type="Node" parent="Mission" node_paths=PackedStringArray("targets")]
script = ExtResource("destroy")
targets = NodePath("../../AAGuns")
description = "Silence the anti-aircraft guns"
optional = true
score_bonus = 150

[node name="DestroyConvoy" type="Node" parent="Mission" node_paths=PackedStringArray("targets")]
