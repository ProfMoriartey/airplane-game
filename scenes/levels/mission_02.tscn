[gd_scene format=3]

[ext_resource type="PackedScene" path="res://scenes/levels/base_level.tscn" id="base"]
[ext_resource type="Script" path="res://scripts/levels/mission_level.gd" id="mission_level"]
[ext_resource type="Script" path="res://scripts/mission/mission.gd" id="mission"]
[ext_resource type="Script" path="res://scripts/mission/reach_area_objective.gd" id="reach"]
[ext_resource type="Script" path="res://scripts/mission/destroy_objective.gd" id="destroy"]
[ext_resource type="Script" path="res://scripts/mission/enemy_squadron.gd" id="squadron"]
[ext_resource type="PackedScene" path="res://scenes/targets/truck.tscn" id="truck"]

[node name="Mission02" instance=ExtResource("base")]
script = ExtResource("mission_level")

[node name="PlayerPlane" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 350, 1900)

[node name="Mission" type="Node" parent="."]
script = ExtResource("mission")
mission_id = "m02"
title = "Dawn Patrol"
briefing = "A quiet morning patrol along our side of the lines. Fly the patrol route and report anything you see. Intelligence says enemy scouts have been sneaking across at dawn - if you meet them, shoot them down."
intro_radio = PackedStringArray("Command: Patrol route is marked. First checkpoint is north-east of the field.", "Command: Keep your eyes open, pilot.")

[node name="Checkpoint1" type="Node" parent="Mission" node_paths=PackedStringArray("area")]
script = ExtResource("reach")
area = NodePath("../../Waypoints/Checkpoint1")
description = "Fly to the first checkpoint"
radius = 350.0
score_bonus = 50

[node name="Checkpoint2" type="Node" parent="Mission" node_paths=PackedStringArray("area")]
script = ExtResource("reach")
area = NodePath("../../Waypoints/Checkpoint2")
description = "Fly to the second checkpoint"
radius = 350.0
score_bonus = 50
radio_on_complete = PackedStringArray("Scout: Enemy aircraft to the north - three of them!")

[node name="Scouts" type="Node" parent="Mission" node_paths=PackedStringArray("targets")]
script = ExtResource("destroy")
targets = NodePath("../../Scouts")
description = "Shoot down the enemy scouts"
radio_on_complete = PackedStringArray("Command: Good work. Finish the patrol.")

[node name="Trucks" type="Node" parent="Mission" node_paths=PackedStringArray("targets")]
script = ExtResource("destroy")
targets = NodePath("../../Trucks")
description = "Strafe the parked supply trucks"
optional = true
score_bonus = 150
radio_on_start = PackedStringArray("Scout: There are enemy trucks parked by the woods to the west. Fair game.")

[node name="Checkpoint3" type="Node" parent="Mission" node_paths=PackedStringArray("area")]
script = ExtResource("reach")
area = NodePath("../../Waypoints/Checkpoint3")
description = "Fly to the last checkpoint"
radius = 350.0
score_bonus = 50

[node name="ReturnToBase" type="Node" parent="Mission" node_paths=PackedStringArray("area")]
script = ExtResource("reach")
area = NodePath("../../Waypoints/Home")
description = "Return to base"
radius = 350.0

[node name="Waypoints" type="Node3D" parent="."]

[node name="Checkpoint1" type="Marker3D" parent="Waypoints"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 700, 320, 800)

[node name="Checkpoint2" type="Marker3D" parent="Waypoints"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 900, 320, -300)

[node name="Checkpoint3" type="Marker3D" parent="Waypoints"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -600, 320, -500)

[node name="Home" type="Marker3D" parent="Waypoints"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 300, 1700)

[node name="Scouts" type="Node3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 700, 420, -1300)
script = ExtResource("squadron")
count = 3
skill = 0

[node name="Trucks" type="Node3D" parent="."]

[node name="Truck1" parent="Trucks" instance=ExtResource("truck")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -950, 0, -150)

[node name="Truck2" parent="Trucks" instance=ExtResource("truck")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -930, 0, -120)

[node name="Truck3" parent="Trucks" instance=ExtResource("truck")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -975, 0, -125)
