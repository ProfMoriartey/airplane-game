[node name="Mission" type="Node" parent="."]
script = ExtResource("mission")
mission_id = "m08"
title = "Nest of Vipers"
briefing = "We've found the airfield of the enemy's best squadron, hidden in a mountain valley. Destroy their hangars and the aircraft parked outside before they can take off. Some of them will get airborne - finish them too."
intro_radio = PackedStringArray("Command: The airfield is in the valley to the north. Hit it hard.", "Command: Planes on the ground can't shoot back. Make the most of it.")

[node name="SilenceGuns" type="Node" parent="Mission" node_paths=PackedStringArray("targets")]
script = ExtResource("destroy")
targets = NodePath("../../AAGuns")
description = "Silence the anti-aircraft guns"
optional = true
score_bonus = 200

[node name="Airfield" type="Node" parent="Mission" node_paths=PackedStringArray("targets")]
script = ExtResource("destroy")
targets = NodePath("../../Airfield")
description = "Destroy the hangars and parked aircraft"
radio_on_start = PackedStringArray("Scout: They're scrambling some fighters from a field further north!")
radio_on_complete = PackedStringArray("Command: Their airfield is burning! Now the ones that got away.")

[node name="Scrambled" type="Node" parent="Mission" node_paths=PackedStringArray("targets")]
