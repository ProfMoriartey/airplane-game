[node name="Mission" type="Node" parent="."]
script = ExtResource("mission")
mission_id = "m06"
title = "Artillery Spotters"
briefing = "The enemy has put up four observation balloons over their side of the mud, ringed with anti-aircraft guns. Their artillery is murdering our infantry. Burn every balloon - their best pilots will be waiting."
intro_radio = PackedStringArray("Command: Four balloons this time, and heavy flak. Go in fast, get out fast.", "Command: And it's raining. Of course it is.")

[node name="SilenceGuns" type="Node" parent="Mission" node_paths=PackedStringArray("targets")]
script = ExtResource("destroy")
targets = NodePath("../../AAGuns")
description = "Silence the anti-aircraft guns"
optional = true
score_bonus = 200

[node name="DestroyBalloons" type="Node" parent="Mission" node_paths=PackedStringArray("targets")]
script = ExtResource("destroy")
targets = NodePath("../../Balloons")
description = "Shoot down the observation balloons"
radio_on_complete = PackedStringArray("Command: All four down! Their veterans are up - watch yourself.")

[node name="Depot" type="Node" parent="Mission" node_paths=PackedStringArray("targets")]
script = ExtResource("destroy")
targets = NodePath("../../Depot")
description = "Bomb the depot behind the balloons"
optional = true
score_bonus = 200

[node name="Fighters" type="Node" parent="Mission" node_paths=PackedStringArray("targets")]
script = ExtResource("destroy")
targets = NodePath("../../Fighters")
description = "Shoot down the enemy fighters"
radio_on_complete = PackedStringArray("Command: You've earned your pay today. Come home.")

[node name="ReturnToBase" type="Node" parent="Mission" node_paths=PackedStringArray("area")]
