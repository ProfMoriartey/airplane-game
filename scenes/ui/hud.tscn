[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://scripts/ui/combat_overlay.gd" id="2_overlay"]

[sub_resource type="StyleBoxFlat" id="Style_radio"]
content_margin_left = 14.0
content_margin_top = 10.0
content_margin_right = 14.0
content_margin_bottom = 10.0
bg_color = Color(0.05, 0.05, 0.04, 0.65)
border_width_left = 3
border_color = Color(0.85, 0.7, 0.45, 1)

[sub_resource type="StyleBoxFlat" id="Style_instruments"]
content_margin_left = 12.0
content_margin_top = 10.0
content_margin_right = 12.0
content_margin_bottom = 10.0
bg_color = Color(0.06, 0.05, 0.04, 0.55)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.45, 0.38, 0.24, 0.7)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[node name="HUD" type="CanvasLayer" groups=["hud"]]
script = ExtResource("1_hud")

[node name="CombatOverlay" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_overlay")

[node name="Instruments" type="PanelContainer" parent="."]
offset_left = 20.0
offset_top = 16.0
offset_right = 280.0
offset_bottom = 230.0
theme_override_styles/panel = SubResource("Style_instruments")

[node name="Rows" type="GridContainer" parent="Instruments"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 4
columns = 2

[node name="Status" type="Label" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -300.0
offset_top = 20.0
offset_right = 300.0
offset_bottom = 60.0
grow_horizontal = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 22
horizontal_alignment = 1

[node name="Banner" type="Label" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -400.0
offset_top = 180.0
offset_right = 400.0
offset_bottom = 240.0
grow_horizontal = 2
theme_override_colors/font_color = Color(1, 0.9, 0.55, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 34
horizontal_alignment = 1

[node name="Warning" type="Label" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -300.0
offset_top = 90.0
offset_right = 300.0
offset_bottom = 170.0
grow_horizontal = 2
theme_override_colors/font_color = Color(1, 0.3, 0.2, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 30
horizontal_alignment = 1

[node name="Message" type="Label" parent="."]
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -400.0
offset_top = -60.0
offset_right = 400.0
offset_bottom = 60.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 10
theme_override_font_sizes/font_size = 40
horizontal_alignment = 1
vertical_alignment = 1

[node name="Help" type="Label" parent="."]
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = -230.0
offset_right = 624.0
offset_bottom = -20.0
grow_vertical = 0
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 5
theme_override_font_sizes/font_size = 16
text = "Space / left mouse  —  fire guns
B  —  drop bomb
W / S  —  nose down / up
A / D  —  roll left / right
Q / E  —  rudder left / right
Shift / Ctrl  —  throttle up / down
C  —  chase / cockpit view
Hold right mouse  —  look around
Esc  —  pause      F1  —  hide help      F3  —  debug"
vertical_alignment = 2

[node name="DebugInfo" type="Label" parent="."]
visible = false
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -424.0
offset_top = 200.0
offset_right = -24.0
offset_bottom = 300.0
grow_horizontal = 0
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 5
theme_override_font_sizes/font_size = 16
horizontal_alignment = 2

[node name="Objectives" type="Label" parent="."]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -444.0
offset_top = 20.0
offset_right = -24.0
offset_bottom = 180.0
grow_horizontal = 0
theme_override_colors/font_color = Color(1, 0.9, 0.55, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 18
horizontal_alignment = 2
autowrap_mode = 3

[node name="Radio" type="PanelContainer" parent="."]
visible = false
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -504.0
