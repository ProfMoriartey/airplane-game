[sub_resource type="Environment" id="Environment_placeholder"]
background_mode = 1

[node name="Menu" type="Node3D"]
script = ExtResource("1_world")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_placeholder")

[node name="Sun" type="DirectionalLight3D" parent="."]
shadow_enabled = true
directional_shadow_max_distance = 400.0

[node name="Terrain" type="StaticBody3D" parent="." groups=["terrain"]]
collision_mask = 0
script = ExtResource("3_terrain")

[node name="Scenery" type="Node3D" parent="."]
script = ExtResource("5_scenery")

[node name="Weather" type="Node" parent="." node_paths=PackedStringArray("world_environment", "sun")]
script = ExtResource("4_weather")
time_of_day = 0
world_environment = NodePath("../WorldEnvironment")
sun = NodePath("../Sun")

[node name="Camera" type="Camera3D" parent="."]
far = 6000.0

[node name="FilmOverlay" parent="." instance=ExtResource("6_film")]

[node name="UI" type="CanvasLayer" parent="."]

[node name="MainMenu" type="Control" parent="UI"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
