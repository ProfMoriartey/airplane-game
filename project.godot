; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="red-ace"
run/main_scene="res://scenes/ui/splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://scripts/autoload/events.gd"
SceneLoader="*res://scripts/autoload/scene_loader.gd"
Profile="*res://scripts/autoload/profile.gd"
Sound="*res://scripts/autoload/sound.gd"
InputSetup="*res://scripts/autoload/input_setup.gd"
Settings="*res://scripts/autoload/settings.gd"
Projectiles="*res://scripts/combat/projectiles.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/theme.tres"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="projectile"
3d_physics/layer_5="ground_target"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=2
